// arrays.kin — Kin 0.2: arrays, for loops, len.

// expect:
// 40
// 60
// 2
// 4
// 6

*mode = S;

func sum(xs: [int]) -> int {
    var total = 0;
    for x in xs {
        total = total + x;
    }
    return total;
}

func main() {
    fin a = [10, 20, 30];
    print(a[0] + a[2]);
    print(sum(a));
    for x in a {
        print(x / 5);
    }
}
