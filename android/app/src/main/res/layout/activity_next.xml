<?xml version="1.0" encoding="utf-8"?>
<!--
  KINN Studio NEXT host: the WebView fills the window; the error panel
  is a dark fallback that only appears when the bundled web app could
  not be loaded (it offers retry and the native classic Studio).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/next_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/next_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_error_title"
            android:textColor="@color/err"
            android:textSize="14sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/next_error_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:typeface="monospace" />

        <Button
            android:id="@+id/next_error_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/next_error_retry" />

        <Button
            android:id="@+id/next_error_classic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/next_error_classic" />
    </LinearLayout>
</FrameLayout>
