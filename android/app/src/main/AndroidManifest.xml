<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline-first: no INTERNET permission, no accounts, no analytics.
         The WebView host (NextActivity) also needs none: every byte is
         served from the APK through WebViewAssetLoader. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KINNStudio">

        <!-- 0.4.0: Studio NEXT (web bundle + wasm compiler) is the
             default interface. Keyboard resize is handled by the page
             (visual-viewport tracking) together with adjustResize. -->
        <activity
            android:name=".NextActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Classic native Studio 0.3 — kept as the fallback, reachable
             from NEXT through the host bridge (no longer the launcher:
             home-screen shortcuts created on 0.3.0 need one re-pin). -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DocsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Offline preview of a generated web build (file:// only). -->
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
