// examples/web/anim_app.kin — the 0.4.0 S6 Phase C animation demo (MPA).
//
// Exercises the predefined animation set shipped in kinnrt.css through
// the grammar's animation surface (B.8): the app-level page
// `transition`, element `enter`/`exit`/`hover`/`press`/`scroll`
// attributes, and an app `animation { … }` block that declares the
// names it references. Add and remove items to see enter/exit waits
// (the runtime keeps an exiting row in the DOM until its animation
// finishes); scroll the list to see the scroll-revealed rows; hover
// and press the buttons for the CSS-driven emphasis animations.
//
// Every name below is one of the nine predefined visuals (fade,
// slide-up, slide-down, slide-left, slide-right, scale, pop, flip-x,
// flip-y). prefers-reduced-motion disables all of it, in CSS and in
// the runtime.
//
// Build:  kinn build examples/web/anim_app.kin --target web

*mode = B;

app "Motion" {
    navigation mpa

    transition "fade"

    animation {
        // Every name the pages reference, declared (E3047) — the visuals
        // for these predefined names ship in kinnrt.css; the timings
        // below ride the manifest for the S8 generated-CSS step.
        transition "fade" { duration 300 }
        transition "slide-up" { duration 300 }
        transition "slide-left" { duration 300 }
        transition "slide-right" { duration 300 }
        transition "scale" { duration 300 }
        keyframes "pop" {
            from { opacity 0 scale 0.94 }
            to { opacity 1 scale 1 }
            duration 300
            easing ease_out
        }
    }

    theme {
        accent "#7c3aed"
        radius "10px"
        max_width "560px"
    }

    state {
        rows: [string] = ["first", "second", "third"]
    }

    computed total = len(rows)

    page Home {
        title "Motion"
        heading "Predefined animations" enter "slide-up"

        text "Rows: " + str(total)

        button "Add a row" hover "pop" press "scale" {
            on click {
                rows = rows + ["row " + str(len(rows) + 1)];
            }
        }

        button "Remove the last row" hover "pop" {
            on click {
                if len(rows) > 0 {
                    var next: [string] = [];
                    for i in 0..len(rows) - 1 {
                        next = next + [rows[i]];
                    }
                    rows = next;
                }
            }
        }

        each rows as row key row {
            text row enter "slide-left" exit "slide-right" scroll "scale"
        }

        link "About this app" open About
    }

    page About {
        title "About"
        heading "About Motion"
        text "The nine predefined KINN animations (fade, the four slides, scale, pop, flip-x, flip-y) ship as CSS in kinnrt.css; the runtime only coordinates classes and waits for exits. Declared keyframes like this app's pop get compiler-generated CSS in the later S8 step — until then their names ride the manifest and render without visible motion unless they match a predefined visual."
        link "Back to the demo" open Home
    }
}
