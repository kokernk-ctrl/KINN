// examples/web/anim_app.kin — the 0.4.0 S6 Phase C animation demo (MPA).
//
// Exercises the predefined animation set shipped in kinnrt.css through
// the grammar's animation surface (B.8): the app-level page
// `transition`, element `enter`/`exit`/`hover`/`press`/`scroll`
// attributes, and an app `animation { … }` block whose declared
// keyframes and transitions now generate REAL CSS (S8): the emitted
// kinnrt.css carries `@keyframes kinn-<name>-in` plus the five
// trigger rules with the declared timing, appended after the
// predefined sheet so a same-named declaration wins. A custom
// "wobble" keyframe exercises the 3D transform chain
// (perspective/translateZ/rotate_x/rotate_y — pure CSS, no JS
// animation loop), and `prefers-reduced-motion` disables all of it,
// in CSS and in the runtime.
// Add and remove items to see enter/exit waits
// (the runtime keeps an exiting row in the DOM until its animation
// finishes); scroll the list to see the scroll-revealed rows; hover
// and press the buttons for the CSS-driven emphasis animations.
//
// The names below are the nine predefined visuals (fade, slide-up,
// slide-down, slide-left, slide-right, scale, pop, flip-x, flip-y)
// plus one declared custom keyframe ("wobble").
//
// Build:  kinn build examples/web/anim_app.kin --target web

*mode = B;

app "Motion" {
    navigation mpa

    transition "fade"

    animation {
        // Every name the pages reference, declared (E3047) — the visuals
        // for these predefined names ship in kinnrt.css; the timings
        // below ride the manifest for the S8 generated-CSS step.
        transition "fade" { duration 300 }
        transition "slide-up" { duration 300 }
        transition "slide-left" { duration 300 }
        transition "slide-right" { duration 300 }
        transition "scale" { duration 300 }
        keyframes "pop" {
            from { opacity 0 scale 0.94 }
            to { opacity 1 scale 1 }
            duration 300
            easing ease_out
        }
        // S8: a custom keyframe with the 3D transform chain — the
        // generated CSS animates perspective(), translateZ() and
        // rotateX()/rotateY() purely through the transform property.
        keyframes "wobble" {
            from { perspective 800 rotate_x -8 rotate_y -6 translate_z 0 opacity 0 }
            step 50 { perspective 800 rotate_x 8 rotate_y 6 translate_z 6 }
            to { perspective 800 rotate_x 0 rotate_y 0 translate_z 0 opacity 1 }
            duration 500
            easing ease_in_out
        }
    }

    theme {
        accent "#7c3aed"
        radius "10px"
        max_width "560px"
    }

    state {
        rows: [string] = ["first", "second", "third"]
    }

    computed total = len(rows)

    page Home {
        title "Motion"
        heading "Predefined animations" enter "slide-up"

        text "Rows: " + str(total)

        button "Add a row" hover "pop" press "scale" {
            on click {
                rows = rows + ["row " + str(len(rows) + 1)];
            }
        }

        button "Remove the last row" hover "pop" {
            on click {
                if len(rows) > 0 {
                    var next: [string] = [];
                    for i in 0..len(rows) - 1 {
                        next = next + [rows[i]];
                    }
                    rows = next;
                }
            }
        }

        each rows as row key row {
            text row enter "slide-left" exit "slide-right" scroll "scale"
        }

        link "About this app" open About
    }

    page About {
        title "About"
        heading "About Motion" enter "wobble"
        text "The nine predefined KINN animations (fade, the four slides, scale, pop, flip-x, flip-y) ship as CSS in kinnrt.css; since S8 the declared keyframes and transitions generate their own CSS — this heading enters through the declared wobble keyframe (a 3D transform chain: perspective, translateZ, rotateX, rotateY)."
        link "Back to the demo" open Home
    }
}
