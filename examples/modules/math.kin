// modules/math.kin — imported by modules/main.kin.
// Modules export their top-level functions AND their top-level consts
// (0.4.0 S1); `main` in an imported file is ignored (the entry file's
// `main` runs).

const MAX: int = 100;

func add(a: int, b: int) -> int {
    return a + b;
}

func square(x: int) -> int {
    return x * x;
}

func clamp(x: int, lo: int, hi: int) -> int {
    return min(max(x, lo), hi);
}
