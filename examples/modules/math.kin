// modules/math.kin — imported by modules/main.kin.
// Modules export their top-level functions; `main` in an imported file
// is ignored (the entry file's `main` runs).

func add(a: int, b: int) -> int {
    return a + b;
}

func square(x: int) -> int {
    return x * x;
}

func clamp(x: int, lo: int, hi: int) -> int {
    return min(max(x, lo), hi);
}
